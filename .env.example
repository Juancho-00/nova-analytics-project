# Copia este archivo como .env y completa los valores reales.
# El archivo .env está en .gitignore y NUNCA debe subirse a git.

AZURE_SQL_SERVER=tu-servidor.database.windows.net
AZURE_SQL_DATABASE=tu-base-de-datos
AZURE_SQL_USER=tu-usuario
AZURE_SQL_PASSWORD=tu-contraseña
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Azure Blob Storage (para scripts futuros en Python)
AZURE_STORAGE_ACCOUNT=tu-storage-account
AZURE_STORAGE_CONTAINER=nova-data
